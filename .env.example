# Copy to .env and run: node --env-file=.env src/app.js  (or set these in your container)
PORT=3000
HOST=0.0.0.0
SQLITE_PATH=./stashly.sqlite

# Signs the unlock cookies. If empty, a random secret is generated once and kept in the database.
SESSION_SECRET=

# Turns on the admin area at /admin (one admin). Leave empty to switch it off.
# The admin can see every stash, delete or extend one, and change the limits below from a settings page.
ADMIN_PASSWORD=
# Start with "only the admin can create stashes" on (needs ADMIN_PASSWORD). Can be changed in the admin settings.
REQUIRE_ADMIN_TO_CREATE=false
COOKIE_SECURE=true

# Set to 1 when running behind one reverse proxy (so rate limits use the real client IP)
TRUST_PROXY=1

MIN_PASSWORD_LENGTH=10
RESERVE_OLD_NAMES_DAYS=30

# Limits
# Largest single note (KB)
MAX_NOTE_KB=100
# Largest single file (MB)
MAX_FILE_MB=25
# Files in one stash
MAX_FILES_PER_STASH=500
# Notes + files in one stash (keep above MAX_FILES_PER_STASH)
MAX_ITEMS_PER_STASH=1000
# Total file size in one stash (MB)
MAX_STASH_MB=100
# Total file size on the whole server (MB)
MAX_TOTAL_MB=2048
# Stashes on the whole server
MAX_STASHES=1000

# Allow stashes that never expire (default: false)
ALLOW_NO_EXPIRY=false

# Rate limits (per IP): creates, posts and uploads are per minute; unlock attempts per 15 minutes
RATE_CREATE=20
RATE_POST=120
RATE_UPLOAD=40
RATE_UNLOCK=10
# Wrong admin passwords per 15 minutes
RATE_ADMIN_LOGIN=10

# Where uploaded files are stored (one plain file each). Default: a "files" folder next to the database.
# Back up the database and this folder together.
FILES_DIR=

# Reading (listing, files, latest, live streams) per address per minute
RATE_READ=600
# Requests for stashes that do not exist, per address per minute
RATE_NOT_FOUND=60
# Open live streams per stash and per address (0 = no limit)
MAX_STREAMS_PER_STASH=100
MAX_STREAMS_PER_IP=30

# Seconds a deleted item can be brought back (0 = deletes are immediate)
UNDO_SECONDS=120
# Largest image thumbnail the page may attach, in KB
MAX_THUMB_KB=200

# Logs: LOG_FORMAT is off or json; AUDIT_LOG is off or stdout
LOG_FORMAT=off
AUDIT_LOG=off
# Set (16+ characters) to turn on /metrics, read with "Authorization: Bearer <token>"
METRICS_TOKEN=

# Resumable uploads
MAX_CHUNK_MB=4
MAX_OPEN_UPLOADS=5
MAX_OPEN_UPLOADS_SERVER=50
UPLOAD_IDLE_HOURS=24
RATE_CHUNK=6000

# Accounts (on only while ADMIN_PASSWORD is set)
USER_SESSION_DAYS=7
REQUIRE_LOGIN_TO_CREATE=false
# Wrong user passwords per address per 15 minutes
RATE_USER_LOGIN=10