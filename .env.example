# Copy to .env.
#   Docker Compose: the compose file reads .env for you (cp .env.example .env, then docker compose up -d).
#   Without Docker: node --env-file=.env src/app.js
# Every line is optional: a variable you leave out (or leave empty) uses the default shown.

# ============================================================================================================
#  1. SET THESE FIRST
#     Most installs only need this section. Fill these in before the first start.
# ============================================================================================================

# REQUIRED for the admin area and accounts. Use a long random value (12+ characters; the server warns below that).
# Leave empty and there is no /admin and no user accounts. The admin signs in with ADMIN_USERNAME + this password.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# STRONGLY RECOMMENDED. A long random value (32+ characters) that signs unlock cookies and share links.
# Keep it the same across restarts: changing it signs everyone out and breaks existing share links.
# If empty, a random one is generated once and kept in the database (so it survives restarts, but is lost with the database).
SESSION_SECRET=

# ============================================================================================================
#  2. BEHIND A REVERSE PROXY OR HTTPS  (set these only if they apply to you)
# ============================================================================================================

# Set to 1 only when running behind one reverse proxy (so rate limits use the real client IP).
# Leave empty otherwise: trusting the proxy header with no proxy lets anyone fake their address.
TRUST_PROXY=

# Cookies marked Secure: auto (follows the connection; the default), true (always) or false.
# "true" breaks sign-in over plain http (a LAN address), so use it only behind HTTPS.
COOKIE_SECURE=auto

# ============================================================================================================
#  3. OPTIONAL: SERVER AND STORAGE
# ============================================================================================================

PORT=3000
HOST=0.0.0.0
# Where the database is kept. Leave this unset in Docker: the image already uses /data/stashly.sqlite, which is on a
# volume. A relative path here would put the database inside the container, and updating the image would delete it.
# Without Docker the default is ./stashly.sqlite.
# SQLITE_PATH=./stashly.sqlite
# Where uploaded files are stored (one plain file each). Default: a "files" folder next to the database.
# Back up the database and this folder together.
FILES_DIR=

# ============================================================================================================
#  4. OPTIONAL: WHO CAN DO WHAT
# ============================================================================================================

# Start with "only the admin can create stashes" on (needs ADMIN_PASSWORD). Can be changed in the admin settings.
REQUIRE_ADMIN_TO_CREATE=false
# Only signed-in users can create stashes (needs ADMIN_PASSWORD). "Only the admin" above wins when both are on.
REQUIRE_LOGIN_TO_CREATE=false
# Days a signed-in account stays signed in (1 to 90)
USER_SESSION_DAYS=7

# Shortest stash password accepted when one is set or changed (4 to 200)
MIN_PASSWORD_LENGTH=10
# A stash with no password is protected only by its name, so the name must be at least this long (0 = no rule)
MIN_OPEN_NAME_LENGTH=10
# Days a name given up by a stash (deleted, expired, renamed) cannot be taken by a new one (0 = off)
RESERVE_OLD_NAMES_DAYS=30
# Allow stashes that never expire (default: false)
ALLOW_NO_EXPIRY=false

# Which files can be uploaded: safe, no-programs or any. Can be changed in the admin settings.
#   safe         images, audio, video, PDF, zip, Office files, certificates and any text file
#   no-programs  also any other file, but not programs, SVG or macro documents
#   any          every file
FILE_TYPES=safe

# ============================================================================================================
#  5. OPTIONAL: SIZE LIMITS
# ============================================================================================================

# Largest single note (KB)
MAX_NOTE_KB=100
# Largest single file (MB)
MAX_FILE_MB=25
# Files in one stash
MAX_FILES_PER_STASH=500
# Notes + files in one stash (keep above MAX_FILES_PER_STASH)
MAX_ITEMS_PER_STASH=1000
# Total file size in one stash (MB)
MAX_STASH_MB=100
# Total file size on the whole server (MB)
MAX_TOTAL_MB=2048
# Stashes on the whole server
MAX_STASHES=1000
# Largest image thumbnail the page may attach, in KB
MAX_THUMB_KB=200
# Seconds a deleted item can be brought back (0 = deletes are immediate)
UNDO_SECONDS=120

# Resumable uploads
MAX_CHUNK_MB=4
MAX_OPEN_UPLOADS=5
MAX_OPEN_UPLOADS_SERVER=50
UPLOAD_IDLE_HOURS=24

# ============================================================================================================
#  6. OPTIONAL: RATE LIMITS AND LOCKOUTS
# ============================================================================================================

# Per IP: creates, posts and uploads are per minute; unlock attempts per 15 minutes
RATE_CREATE=20
RATE_POST=120
RATE_UPLOAD=40
RATE_UNLOCK=10
RATE_CHUNK=6000
# Reading (listing, files, latest, live streams) per address per minute
RATE_READ=600
# Requests for stashes that do not exist, per address per minute
RATE_NOT_FOUND=60
# Wrong admin passwords per 15 minutes
RATE_ADMIN_LOGIN=10
# Wrong user passwords per address per 15 minutes
RATE_USER_LOGIN=10

# Wrong passwords for one stash, per visitor, before unlocking it is refused for the window below (0 = off)
STASH_UNLOCK_FAILURES=10
# That window, in minutes
STASH_UNLOCK_WINDOW_MIN=15

# Open live streams per stash and per address (0 = no limit)
MAX_STREAMS_PER_STASH=100
MAX_STREAMS_PER_IP=30

# ============================================================================================================
#  7. OPTIONAL: LOGS AND METRICS
# ============================================================================================================

# LOG_FORMAT is off or json; AUDIT_LOG is off or stdout. Both write to the container log (docker logs).
LOG_FORMAT=off
AUDIT_LOG=off
# Set (16+ characters) to turn on /metrics, read with "Authorization: Bearer <token>"
METRICS_TOKEN=
