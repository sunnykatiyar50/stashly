{
  "name": "stashly",
  "version": "5.5.6",
  "description": "Self-hosted shared stash: open the same link on machines that can't reach each other and trade text, images and files.",
  "main": "src/app.js",
  "bin": {
    "stashly": "bin/stashly.js"
  },
  "scripts": {
    "release": "node scripts/release.js",
    "build:extension": "node scripts/build-extension.js",
    "start": "node --disable-warning=ExperimentalWarning src/app.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/app.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "10.6.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "mailparser": "3.15.0",
    "smtp-server": "3.21.7",
    "supertest": "^7.3.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  }
}
